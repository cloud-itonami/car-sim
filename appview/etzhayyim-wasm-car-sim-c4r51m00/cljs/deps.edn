;; car-sim appview frontend — reagent + re-frame, rendered with jp-go-dds
;; (デジタル庁デザインシステム). Migrated from
;; appview/etzhayyim-wasm-car-sim-c4r51m00/svelte (SvelteKit 2 + Svelte 5 +
;; adapter-cloudflare).
;;
;; reagent/re-frame/clojurescript/shadow-cljs live under the :cljs alias
;; rather than top-level :deps (workspace convention — see
;; orgs/kotoba-lang/kami-genko/deps.edn and orgs/cloud-itonami/app-gyotaku's
;; cljs/deps.edn for the same shape: "so library consumers don't inherit
;; reagent/re-frame/shadow-cljs"). jp-go-dds is a workspace git dep and stays
;; top-level. This also keeps the PreToolUse hook jvm-new-surface-guard
;; (ADR-2608201300, which denies new top-level JVM runtime deps) satisfied.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}
 :aliases {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                                thheller/shadow-cljs {:mvn/version "2.28.20"}
                                reagent/reagent {:mvn/version "1.2.0"}
                                re-frame/re-frame {:mvn/version "1.4.3"}}}
           :test {:extra-paths ["test"]}}}
